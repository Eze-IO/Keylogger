<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net8.0-windows</TargetFrameworks>
    <RootNamespace>Eze.IO.Workspace</RootNamespace>
    <AssemblyName>Keyboard</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ComVisible and the type library Guid stay in Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <Version>1.1.0</Version>
    <Authors>Eze-IO</Authors>
    <Company>Eze-IO</Company>
    <Product>Keyboard</Product>
    <Copyright>Copyright © 2018-2026 Eze-IO</Copyright>
    <Description>A library that uses the Windows low-level keyboard hook (WH_KEYBOARD_LL) to raise an event on key presses, with COM support.</Description>

    <PackageId>EzeIO.Keylogger</PackageId>
    <PackageTags>keyboard;keys;input;hook;windows;com</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Eze-IO/Keylogger</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Eze-IO/Keylogger</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <!-- Lets the .NET Framework target build without a Framework targeting pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
